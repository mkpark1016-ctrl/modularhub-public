{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularhub.local/schemas/company_monitoring/candidate.schema.json",
  "title": "Company monitoring candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "company_id",
    "candidate_kind",
    "domain",
    "title",
    "summary",
    "source_id",
    "source_type",
    "source_tier",
    "publisher",
    "source_url",
    "fetched_at",
    "evidence_hash",
    "entity_match_score",
    "relevance_score",
    "confidence",
    "review_status",
    "promotion_blockers",
    "duplicate_of"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 8 },
    "company_id": { "type": "string", "minLength": 1 },
    "candidate_kind": { "enum": ["fact", "event", "evidence"] },
    "domain": { "enum": ["identity", "financial", "production", "project", "technology", "strategy", "organization", "market"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "proposed_value": {},
    "current_value": {},
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "source_tier": { "enum": ["A", "B", "C", "D"] },
    "publisher": { "type": "string" },
    "source_url": { "type": "string" },
    "document_id": { "type": ["string", "null"] },
    "published_at": { "type": ["string", "null"] },
    "fetched_at": { "type": "string" },
    "evidence_hash": { "type": "string", "minLength": 16 },
    "entity_match_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "review_status": { "enum": ["pending", "accepted", "rejected", "duplicate", "superseded"] },
    "promotion_blockers": { "type": "array", "items": { "type": "string" } },
    "duplicate_of": { "type": ["string", "null"] },
    "project_credit": { "type": ["boolean", "null"] },
    "event_status": { "type": ["string", "null"] },
    "query": { "type": ["string", "null"] },
    "raw_ref": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
