{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularhub.local/schemas/company_reports/company_data_coverage_v1.schema.json",
  "title": "Company Data Coverage v1",
  "type": "object",
  "required": [
    "schema_version",
    "as_of_date",
    "summary",
    "companies",
    "priority_queue",
    "audit_coverage",
    "evidence_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "company_data_coverage_v1"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_company_count",
        "audit_backed_company_count",
        "non_audit_company_count",
        "company_ids",
        "audit_company_ids",
        "non_audit_company_ids",
        "priority_counts"
      ],
      "properties": {
        "total_company_count": {
          "type": "integer",
          "minimum": 0
        },
        "audit_backed_company_count": {
          "type": "integer",
          "minimum": 0
        },
        "audit_backed_in_universe_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_audit_company_count": {
          "type": "integer",
          "minimum": 0
        },
        "full_three_year_audit_count": {
          "type": "integer",
          "minimum": 0
        },
        "company_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_company_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_company_ids_not_in_universe": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_audit_company_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority_counts": {
          "$ref": "#/$defs/priority_counts"
        }
      },
      "additionalProperties": true
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "priority_queue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/priority_item"
      }
    },
    "stale_domains": {
      "type": "array"
    },
    "audit_coverage": {
      "type": "object"
    },
    "evidence_coverage": {
      "type": "object"
    }
  },
  "$defs": {
    "state_audit": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "verification_pending"
      ]
    },
    "state_operational": {
      "enum": [
        "sufficiently_covered",
        "partial",
        "sparse",
        "unavailable"
      ]
    },
    "state_evidence": {
      "enum": [
        "verified",
        "mixed",
        "pending",
        "sparse"
      ]
    },
    "state_freshness": {
      "enum": [
        "current",
        "aging",
        "stale",
        "unknown"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "priority_counts": {
      "type": "object",
      "required": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "properties": {
        "P0": {
          "type": "integer",
          "minimum": 0
        },
        "P1": {
          "type": "integer",
          "minimum": 0
        },
        "P2": {
          "type": "integer",
          "minimum": 0
        },
        "P3": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "metric_coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "reported",
          "not_disclosed",
          "not_applicable",
          "verification_pending",
          "missing",
          "by_year"
        ],
        "properties": {
          "reported": {
            "type": "integer",
            "minimum": 0
          },
          "not_disclosed": {
            "type": "integer",
            "minimum": 0
          },
          "not_applicable": {
            "type": "integer",
            "minimum": 0
          },
          "verification_pending": {
            "type": "integer",
            "minimum": 0
          },
          "missing": {
            "type": "integer",
            "minimum": 0
          },
          "by_year": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "reported",
                "not_disclosed",
                "not_applicable",
                "verification_pending",
                "missing"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "company": {
      "type": "object",
      "required": [
        "company_id",
        "company_name",
        "audit_financials_available",
        "required_metric_coverage",
        "audit_coverage_state",
        "operational_coverage_state",
        "evidence_coverage_state",
        "freshness_state",
        "recommendation_priority",
        "recommendation_reason_codes"
      ],
      "properties": {
        "company_id": {
          "type": "string"
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_financials_available": {
          "type": "boolean"
        },
        "audit_years": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "latest_audit_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "required_metric_coverage": {
          "$ref": "#/$defs/metric_coverage"
        },
        "optional_metric_coverage": {
          "$ref": "#/$defs/metric_coverage"
        },
        "audit_coverage_state": {
          "$ref": "#/$defs/state_audit"
        },
        "operational_coverage_state": {
          "$ref": "#/$defs/state_operational"
        },
        "evidence_coverage_state": {
          "$ref": "#/$defs/state_evidence"
        },
        "freshness_state": {
          "$ref": "#/$defs/state_freshness"
        },
        "recommendation_priority": {
          "$ref": "#/$defs/priority"
        },
        "recommendation_reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "priority_item": {
      "type": "object",
      "required": [
        "priority",
        "company_id",
        "recommended_next_action",
        "recommended_next_domain",
        "reason_codes"
      ],
      "properties": {
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "company_id": {
          "type": "string"
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended_next_action": {
          "type": "string"
        },
        "recommended_next_domain": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
